{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": [
    "config",
    "agentic",
    "fixtures",
    "pages",
    "api",
    "data",
    "tests",
    "unit",
    "utils",
    "types",
    "playwright.config.ts",
    "eslint.config.mjs",
    "vitest.config.ts"
  ]
}
